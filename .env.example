# === Application ===
NODE_ENV=development
PORT=3000
REACT_APP_API_URL=http://localhost:8000/api

# === Database ===
MONGODB_URI=mongodb://localhost:27017/saske
REDIS_URL=redis://localhost:6379

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# === Authentication ===
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
API_KEY=your_api_key

# === Blockchain ===
PRIVATE_KEY=your_private_key_here
SASKE_MAINNET_RPC_URL=https://mainnet.saske.xyz
SASKE_TESTNET_RPC_URL=https://testnet.saske.xyz
ETHEREUM_NODE_URL=http://localhost:8545
CONTRACT_ADDRESS=your_contract_address
SASKE_EMOTION_TOKEN_ADDRESS=your_contract_address_here

# === IPFS ===
IPFS_NODE_URL=http://localhost:5001
IPFS_API_KEY=your_ipfs_api_key_here

# === Etherscan ===
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# === AI/ML ===
TENSORFLOW_MODEL_PATH=./models
OPENAI_API_KEY=your_openai_api_key

# === Security ===
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# === Monitoring ===
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# === Email ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
